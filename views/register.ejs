<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Register - BookWise</title>
    <%- include('partials/head-assets') %>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container" style="max-width: 500px;">
        <h1 class="mt-5">Register</h1>
        <% if (messages && messages.length > 0) { %>
            <div class="alert alert-danger">
                <% messages.forEach(function(message) { %><p class="mb-0"><%= message %></p><% }); %>
            </div>
        <% } %>
        <form action="/register" method="POST" class="mt-4">
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="username" class="form-control" required
                    value="<%= (formData && formData.username) ? formData.username : '' %>">
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" class="form-control" required
                    value="<%= (formData && formData.email) ? formData.email : '' %>">
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-control" required>
                <div class="form-text">At least 6 characters.</div>
            </div>
            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required>
                <div class="invalid-feedback" id="confirmPasswordFeedback">Passwords do not match.</div>
            </div>
            <div class="mb-3">
                <label for="contact" class="form-label">Contact Number</label>
                <input type="text" id="contact" name="contact" class="form-control" required
                    value="<%= (formData && formData.contact) ? formData.contact : '' %>">
            </div>
            <div class="mb-3">
                <label for="department" class="form-label">Department / Course</label>
                <select id="department" name="department" class="form-select" required>
                    <option value="" disabled <%= (!formData || !formData.department) ? 'selected' : '' %>>Select your course</option>

                    <optgroup label="School of Applied Science">
                        <option value="Common Science Programme (R59)" <%= (formData && formData.department === 'Common Science Programme (R59)') ? 'selected' : '' %>>Common Science Programme (R59)</option>
                        <option value="Diploma in Applied Chemistry (R17)" <%= (formData && formData.department === 'Diploma in Applied Chemistry (R17)') ? 'selected' : '' %>>Diploma in Applied Chemistry (R17)</option>
                        <option value="Diploma in Biological Sciences (R16)" <%= (formData && formData.department === 'Diploma in Biological Sciences (R16)') ? 'selected' : '' %>>Diploma in Biological Sciences (R16)</option>
                        <option value="Diploma in Biomedical Science (R14)" <%= (formData && formData.department === 'Diploma in Biomedical Science (R14)') ? 'selected' : '' %>>Diploma in Biomedical Science (R14)</option>
                        <option value="Diploma in Environmental & Marine Science (R11)" <%= (formData && formData.department === 'Diploma in Environmental & Marine Science (R11)') ? 'selected' : '' %>>Diploma in Environmental & Marine Science (R11)</option>
                        <option value="Diploma in Pharmaceutical Science (R18)" <%= (formData && formData.department === 'Diploma in Pharmaceutical Science (R18)') ? 'selected' : '' %>>Diploma in Pharmaceutical Science (R18)</option>
                    </optgroup>

                    <optgroup label="School of Business">
                        <option value="Common Business Programme (R57)" <%= (formData && formData.department === 'Common Business Programme (R57)') ? 'selected' : '' %>>Common Business Programme (R57)</option>
                        <option value="Diploma in Business (R60)" <%= (formData && formData.department === 'Diploma in Business (R60)') ? 'selected' : '' %>>Diploma in Business (R60)</option>
                        <option value="Diploma in Consumer Insights & Psychology (R62)" <%= (formData && formData.department === 'Diploma in Consumer Insights & Psychology (R62)') ? 'selected' : '' %>>Diploma in Consumer Insights & Psychology (R62)</option>
                        <option value="Diploma in Defence & Security Management (R39)" <%= (formData && formData.department === 'Diploma in Defence & Security Management (R39)') ? 'selected' : '' %>>Diploma in Defence & Security Management (R39)</option>
                        <option value="Diploma in Human Resource Management with Psychology (R52)" <%= (formData && formData.department === 'Diploma in Human Resource Management with Psychology (R52)') ? 'selected' : '' %>>Diploma in Human Resource Management with Psychology (R52)</option>
                        <option value="Diploma in Mass Communication (R32)" <%= (formData && formData.department === 'Diploma in Mass Communication (R32)') ? 'selected' : '' %>>Diploma in Mass Communication (R32)</option>
                    </optgroup>

                    <optgroup label="School of Engineering">
                        <option value="Common Engineering Programme (R42)" <%= (formData && formData.department === 'Common Engineering Programme (R42)') ? 'selected' : '' %>>Common Engineering Programme (R42)</option>
                        <option value="Diploma in Aerospace Engineering (R40)" <%= (formData && formData.department === 'Diploma in Aerospace Engineering (R40)') ? 'selected' : '' %>>Diploma in Aerospace Engineering (R40)</option>
                        <option value="Diploma in Aviation Management (R41)" <%= (formData && formData.department === 'Diploma in Aviation Management (R41)') ? 'selected' : '' %>>Diploma in Aviation Management (R41)</option>
                        <option value="Diploma in Business Process & Engineering Management (R11)" <%= (formData && formData.department === 'Diploma in Business Process & Engineering Management (R11)') ? 'selected' : '' %>>Diploma in Business Process & Engineering Management (R11)</option>
                        <option value="Diploma in Electrical & Electronic Engineering (R56)" <%= (formData && formData.department === 'Diploma in Electrical & Electronic Engineering (R56)') ? 'selected' : '' %>>Diploma in Electrical & Electronic Engineering (R56)</option>
                        <option value="Diploma in Engineering (R56)" <%= (formData && formData.department === 'Diploma in Engineering (R56)') ? 'selected' : '' %>>Diploma in Engineering (R56)</option>
                        <option value="Diploma in Mobility & Robotic Systems (R54)" <%= (formData && formData.department === 'Diploma in Mobility & Robotic Systems (R54)') ? 'selected' : '' %>>Diploma in Mobility & Robotic Systems (R54)</option>
                        <option value="Diploma in Supply Chain Management (R20)" <%= (formData && formData.department === 'Diploma in Supply Chain Management (R20)') ? 'selected' : '' %>>Diploma in Supply Chain Management (R20)</option>
                        <option value="Diploma in Sustainable Built Environment (R21)" <%= (formData && formData.department === 'Diploma in Sustainable Built Environment (R21)') ? 'selected' : '' %>>Diploma in Sustainable Built Environment (R21)</option>
                    </optgroup>

                    <optgroup label="School of Hospitality">
                        <option value="Diploma in Events & Project Management (R28)" <%= (formData && formData.department === 'Diploma in Events & Project Management (R28)') ? 'selected' : '' %>>Diploma in Events & Project Management (R28)</option>
                        <option value="Diploma in Hospitality & Tourism Management (R66)" <%= (formData && formData.department === 'Diploma in Hospitality & Tourism Management (R66)') ? 'selected' : '' %>>Diploma in Hospitality & Tourism Management (R66)</option>
                        <option value="Diploma in Hotel & Leisure Management (R37)" <%= (formData && formData.department === 'Diploma in Hotel & Leisure Management (R37)') ? 'selected' : '' %>>Diploma in Hotel & Leisure Management (R37)</option>
                        <option value="Diploma in Restaurant & Culinary Management (R46)" <%= (formData && formData.department === 'Diploma in Restaurant & Culinary Management (R46)') ? 'selected' : '' %>>Diploma in Restaurant & Culinary Management (R46)</option>
                    </optgroup>

                    <optgroup label="School of Infocomm">
                        <option value="Common ICT Programme (R58)" <%= (formData && formData.department === 'Common ICT Programme (R58)') ? 'selected' : '' %>>Common ICT Programme (R58)</option>
                        <option value="Diploma in Applied AI & Analytics (R13)" <%= (formData && formData.department === 'Diploma in Applied AI & Analytics (R13)') ? 'selected' : '' %>>Diploma in Applied AI & Analytics (R13)</option>
                        <option value="Diploma in Cybersecurity & Digital Forensics (R55)" <%= (formData && formData.department === 'Diploma in Cybersecurity & Digital Forensics (R55)') ? 'selected' : '' %>>Diploma in Cybersecurity & Digital Forensics (R55)</option>
                        <option value="Diploma in Enterprise Cloud Computing & Management (R12)" <%= (formData && formData.department === 'Diploma in Enterprise Cloud Computing & Management (R12)') ? 'selected' : '' %>>Diploma in Enterprise Cloud Computing & Management (R12)</option>
                        <option value="Diploma in Financial Technology (R18)" <%= (formData && formData.department === 'Diploma in Financial Technology (R18)') ? 'selected' : '' %>>Diploma in Financial Technology (R18)</option>
                        <option value="Diploma in Information Technology (R12)" <%= (formData && formData.department === 'Diploma in Information Technology (R12)') ? 'selected' : '' %>>Diploma in Information Technology (R12)</option>
                    </optgroup>

                    <optgroup label="School of Sports and Health">
                        <option value="Common Sports & Health Programme (R63)" <%= (formData && formData.department === 'Common Sports & Health Programme (R63)') ? 'selected' : '' %>>Common Sports & Health Programme (R63)</option>
                        <option value="Diploma in Integrated Community Care (R45)" <%= (formData && formData.department === 'Diploma in Integrated Community Care (R45)') ? 'selected' : '' %>>Diploma in Integrated Community Care (R45)</option>
                        <option value="Diploma in Outdoor Education (R33)" <%= (formData && formData.department === 'Diploma in Outdoor Education (R33)') ? 'selected' : '' %>>Diploma in Outdoor Education (R33)</option>
                        <option value="Diploma in Sport & Exercise Science (R26)" <%= (formData && formData.department === 'Diploma in Sport & Exercise Science (R26)') ? 'selected' : '' %>>Diploma in Sport & Exercise Science (R26)</option>
                        <option value="Diploma in Sport Coaching (R49)" <%= (formData && formData.department === 'Diploma in Sport Coaching (R49)') ? 'selected' : '' %>>Diploma in Sport Coaching (R49)</option>
                        <option value="Diploma in Sports & Health (R43)" <%= (formData && formData.department === 'Diploma in Sports & Health (R43)') ? 'selected' : '' %>>Diploma in Sports & Health (R43)</option>
                    </optgroup>

                    <optgroup label="School of Technology for Arts, Media and Design">
                        <option value="Common Arts, Media & Design Programme (R65)" <%= (formData && formData.department === 'Common Arts, Media & Design Programme (R65)') ? 'selected' : '' %>>Common Arts, Media & Design Programme (R65)</option>
                        <option value="Diploma in Arts & Entertainment Production Management (R25)" <%= (formData && formData.department === 'Diploma in Arts & Entertainment Production Management (R25)') ? 'selected' : '' %>>Diploma in Arts & Entertainment Production Management (R25)</option>
                        <option value="Diploma in Design (R67)" <%= (formData && formData.department === 'Diploma in Design (R67)') ? 'selected' : '' %>>Diploma in Design (R67)</option>
                        <option value="Diploma in Digital Content Creation (R19)" <%= (formData && formData.department === 'Diploma in Digital Content Creation (R19)') ? 'selected' : '' %>>Diploma in Digital Content Creation (R19)</option>
                        <option value="Diploma in Sonic Arts (R24)" <%= (formData && formData.department === 'Diploma in Sonic Arts (R24)') ? 'selected' : '' %>>Diploma in Sonic Arts (R24)</option>
                    </optgroup>
                </select>
            </div>
            <div class="mb-3">
                <label for="role" class="form-label">Role</label>
                <select id="role" name="role" class="form-select" required>
                    <option value="student" <%= (formData && formData.role === 'student') ? 'selected' : '' %>>Student</option>
                    <option value="admin" <%= (formData && formData.role === 'admin') ? 'selected' : '' %>>Admin</option>
                </select>
            </div>
            <div class="mb-3" id="adminCodeGroup" style="display: none;">
                <label for="adminCode" class="form-label">Admin Code</label>
                <input type="password" id="adminCode" name="adminCode" class="form-control"
                    placeholder="Enter admin code"
                    value="<%= (formData && formData.adminCode) ? formData.adminCode : '' %>">
                <div class="form-text">Required to register as an Admin.</div>
            </div>
            <button type="submit" class="btn btn-primary">Register</button>
        </form>
        <p class="mt-3">Already have an account? <a href="/login">Login here</a></p>
    </div>
    <script>
        const roleSelect = document.getElementById('role');
        const adminCodeGroup = document.getElementById('adminCodeGroup');
        const adminCodeInput = document.getElementById('adminCode');

        function toggleAdminCode() {
            const isAdmin = roleSelect.value === 'admin';
            adminCodeGroup.style.display = isAdmin ? 'block' : 'none';
            adminCodeInput.required = isAdmin;
            if (!isAdmin) {
                adminCodeInput.value = '';
            }
        }

        roleSelect.addEventListener('change', toggleAdminCode);
        toggleAdminCode();

        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');

        function checkPasswordsMatch() {
            if (confirmPasswordInput.value && confirmPasswordInput.value !== passwordInput.value) {
                confirmPasswordInput.setCustomValidity('Passwords do not match.');
                confirmPasswordInput.classList.add('is-invalid');
            } else {
                confirmPasswordInput.setCustomValidity('');
                confirmPasswordInput.classList.remove('is-invalid');
            }
        }

        passwordInput.addEventListener('input', checkPasswordsMatch);
        confirmPasswordInput.addEventListener('input', checkPasswordsMatch);
    </script>
    <%- include('partials/footer') %>
</body>
</html>
